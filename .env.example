# Required for production SEO URLs (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://gamevado.com

# Optional until a public support inbox is ready
NEXT_PUBLIC_CONTACT_EMAIL=

# Optional public GA4 Measurement ID; leave empty to disable analytics
NEXT_PUBLIC_GA_ID=

# Google AdSense: use IDs from your own approved account/ad units
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_GAME_BOTTOM_SLOT=
NEXT_PUBLIC_ADSENSE_INLINE_SLOT=

# Server-side UGC integration. Use the Supabase project URL and publishable/anon key.
# These values are deliberately not NEXT_PUBLIC: game pages never load the auth client.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Keep false during Phase 1. To open posting later, also enable private.ugc_settings
# in the database after moderation and abuse protection are operational.
UGC_WRITES_ENABLED=false

# Required for production login. Configure the Turnstile secret in Supabase Auth,
# which verifies the forwarded captcha_token once. Do not verify the same token twice.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
